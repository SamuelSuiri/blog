---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Blog y contenidos de Samuel Suiri' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta http-equiv="Strict-Transport-Security" content="max-age=63072000; includeSubDomains; preload" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      :root {
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        --color-bg: #0d1117;
        --color-surface: #161b22;
        --color-surface-hover: #1f242c;
        --color-border: #30363d;
        --color-text: #c9d1d9;
        --color-text-muted: #8b949e;
        --color-heading: #f0f6fc;
        --color-accent: #58a6ff;
        --color-accent-hover: #79c0ff;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: var(--font-sans);
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      a {
        color: var(--color-accent);
        text-decoration: none;
        transition: color 0.2s ease;
      }
      a:hover {
        color: var(--color-accent-hover);
      }
      header {
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface);
        padding: 1.25rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .brand {
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--color-heading);
      }
      .site-container {
        max-width: 1200px;
        width: 100%;
        margin: 2rem auto;
        padding: 0 1.5rem;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 2.5rem;
        flex: 1;
      }
      @media (max-width: 900px) {
        .site-container {
          grid-template-columns: 1fr;
        }
      }
      .sidebar {
        display: flex;
        flex-direction: column;
        gap: 2rem;
      }
      .sidebar-widget {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
      }
      .sidebar-widget h3 {
        font-size: 1.1rem;
        color: var(--color-heading);
        margin-bottom: 1rem;
        border-bottom: 1px solid var(--color-border);
        padding-bottom: 0.5rem;
      }
      .sidebar-widget ul {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }
      .sidebar-widget li a {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--color-text);
        font-size: 0.95rem;
      }
      .sidebar-widget li a:hover {
        color: var(--color-accent);
      }
      footer {
        border-top: 1px solid var(--color-border);
        text-align: center;
        padding: 2rem;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }
      @view-transition {
        navigation: auto;
      }
    </style>
  </head>
  <body>
    <header>
      <a href="/" class="brand">Samuel Suiri</a>
      <nav>
        <a href="/">Inicio</a>
      </nav>
    </header>

    <div class="site-container">
      <main>
        <slot />
      </main>

      <aside class="sidebar">
        <section class="sidebar-widget">
          <h3>Proyectos & Ecosistema</h3>
          <ul>
            <li>
              <a href="https://samsuiri.qd.je" target="_blank" rel="noopener noreferrer">
                <span>🌐</span> Portal Principal (WP Core)
              </a>
            </li>
            <li>
              <a href="https://github.com/SamuelSuiri" target="_blank" rel="noopener noreferrer">
                <span>💻</span> GitHub: SamuelSuiri
              </a>
            </li>
            <li>
              <a href="https://github.com/MundoSuiri" target="_blank" rel="noopener noreferrer">
                <span>⚡</span> Org MundoSuiri
              </a>
            </li>
            <li>
              <a href="https://github.com/SamuelSuiri/blog" target="_blank" rel="noopener noreferrer">
                <span>📦</span> Repositorio del Blog Headless
              </a>
            </li>
          </ul>
        </section>

        <section class="sidebar-widget">
          <h3>Conexiones & Redes</h3>
          <ul>
            <li>
              <a href="https://samsuiri.qd.je/@samuel" target="_blank" rel="me noopener noreferrer">
                <span>🐘</span> Mastodon / Fediverse
              </a>
            </li>
            <li>
              <a href="https://astro.samsuiri.qd.je" target="_blank" rel="noopener noreferrer">
                <span>☁️</span> Cloudflare Edge (astro)
              </a>
            </li>
            <li>
              <a href="https://ghp.samsuiri.qd.je" target="_blank" rel="noopener noreferrer">
                <span>🐙</span> GitHub Pages Edge (ghp)
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>

    <footer>
      <p>&copy; {new Date().getFullYear()} Samuel Suiri. Headless WordPress + Astro 7 Edge.</p>
    </footer>
  </body>
</html>
