---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, getRelatedPosts, type Post } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts
    .filter((post) => Boolean(post.slug && post.slug.trim()))
    .map((post) => {
      let cleanSlug = post.slug;
      try {
        cleanSlug = decodeURIComponent(post.slug);
      } catch {}
      return {
        params: { slug: cleanSlug },
        props: { post, allPosts: posts }
      };
    });
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post, allPosts } = Astro.props;

const relatedPosts = getRelatedPosts(post, allPosts, 4);

const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;
const postDate = new Date(post.date).toLocaleDateString('es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<BaseLayout title={`${post.title.rendered} — Samuel Suiri`}>
  <article class="single-post">
    <header class="post-header">
      <time datetime={post.date}>{postDate}</time>
      <h1 set:html={post.title.rendered} />
    </header>

    {featuredImage && (
      <img src={featuredImage} alt={post.title.rendered} class="hero-image" />
    )}

    <div class="content" set:html={post.content.rendered} />

    <!-- Sección de Entradas Relacionadas -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <h2>Entradas Relacionadas</h2>
        <div class="related-grid">
          {relatedPosts.map((rel) => {
            const relImg = rel._embedded?.['wp:featuredmedia']?.[0]?.source_url;
            return (
              <a href={`/posts/${rel.slug}`} class="related-card">
                {relImg && <img src={relImg} alt={rel.title.rendered} class="related-thumb" loading="lazy" />}
                <div class="related-title" set:html={rel.title.rendered} />
              </a>
            );
          })}
        </div>
      </section>
    )}

    <nav class="back-nav">
      <a href="/">&larr; Volver a la bitácora</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .single-post {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .post-header time {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .post-header h1 {
    font-size: 2.25rem;
    color: var(--color-heading);
    margin-top: 0.5rem;
    line-height: 1.25;
  }
  .hero-image {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: 8px;
  }
  .content {
    font-size: 1.05rem;
    line-height: 1.8;
  }
  .content :global(p) {
    margin-bottom: 1.25rem;
  }
  .content :global(h2),
  .content :global(h3) {
    color: var(--color-heading);
    margin: 2rem 0 1rem 0;
  }
  .content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: 1rem;
    color: var(--color-text-muted);
    margin: 1.5rem 0;
  }
  .related-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .related-section h2 {
    font-size: 1.4rem;
    color: var(--color-heading);
    margin-bottom: 1.25rem;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }
  .related-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .related-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .related-thumb {
    width: 100%;
    height: 120px;
    object-fit: cover;
    border-radius: 4px;
  }
  .related-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-heading);
    line-height: 1.4;
  }
  .back-nav {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
</style>
