---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPosts } from '../lib/wp';

const posts = await getPosts();
---

<BaseLayout title="Blog — Samuel Suiri">
  <section class="hero">
    <h1>Bitácora y Publicaciones</h1>
    <p class="subtitle">Artículos, reflexiones y notas sincronizadas desde el backend WordPress.</p>
  </section>

  <section class="posts-list">
    {posts.length === 0 ? (
      <p class="empty-state">No se pudieron cargar artículos en este momento.</p>
    ) : (
      posts.map((post) => {
        const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;
        const postDate = new Date(post.date).toLocaleDateString('es-ES', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });

        return (
          <article class="post-card">
            {featuredImage && (
              <img src={featuredImage} alt={post.title.rendered} class="post-thumb" loading="lazy" />
            )}
            <div class="post-info">
              <time datetime={post.date}>{postDate}</time>
              <h2>
                <a href={`/posts/${post.slug}`} set:html={post.title.rendered} />
              </h2>
              <div class="excerpt" set:html={post.excerpt.rendered} />
              <a href={`/posts/${post.slug}`} class="read-more">Leer artículo &rarr;</a>
            </div>
          </article>
        );
      })
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 3rem;
  }
  .hero h1 {
    font-size: 2.25rem;
    color: var(--color-heading);
    margin-bottom: 0.5rem;
  }
  .subtitle {
    font-size: 1.1rem;
    color: #8b949e;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .post-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .post-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .post-thumb {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: 6px;
  }
  time {
    font-size: 0.85rem;
    color: #8b949e;
  }
  .post-info h2 {
    font-size: 1.4rem;
    margin: 0.25rem 0 0.75rem 0;
  }
  .post-info h2 a {
    color: var(--color-heading);
  }
  .post-info h2 a:hover {
    color: var(--color-accent);
  }
  .excerpt {
    font-size: 0.95rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }
  .read-more {
    font-weight: 600;
    font-size: 0.9rem;
  }
  .empty-state {
    color: #8b949e;
    font-style: italic;
  }
</style>
